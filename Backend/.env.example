# Server Configuration
PORT=3000
NODE_ENV=development

# Blockchain Configuration
RPC_URL=https://your-rpc-endpoint-here.com
# Example: https://sepolia.infura.io/v3/YOUR-PROJECT-ID
# or https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY

# Private Key (Optional - only needed for write operations)
# PRIVATE_KEY=your_private_key_here

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/assettoken?schema=public"
# Example: postgresql://postgres:password@localhost:5432/assettoken

# Contract Addresses (Update these with your deployed contract addresses)
ASSET_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PRIMARY_SALE_ADDRESS=0x0000000000000000000000000000000000000000
AMM_POOL_ADDRESS=0x0000000000000000000000000000000000000000
